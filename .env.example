# LLM Providers (at least one required)
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...

# Diagnosis engine
MAST_LLM_PROVIDER=groq          # groq | openai | anthropic | google
MAST_LLM_MODEL=llama-3.1-70b-versatile  # model name for chosen provider

# Database
MAST_DATABASE_URL=sqlite:///./mast.db  # or postgresql://...

# Server
MAST_HOST=0.0.0.0
MAST_PORT=8000
